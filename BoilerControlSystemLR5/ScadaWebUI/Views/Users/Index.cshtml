@model List<UserRoleRow>
@{
    ViewData["Title"] = "Керування користувачами";
}

<div class="container mt-3">
    <h2>Users</h2>
    @if (TempData["Message"] != null)
    {
        <p class="text-success fw-bold">@TempData["Message"]</p>
    }

    <table class="table table-bordered align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Email</th>
                <th>Role</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.Email</td>
                    <td>
                        <form method="post" asp-action="SetRole" class="d-flex gap-2">
                            <input type="hidden" name="id" value="@u.Id" />
                            <select name="role" class="form-select w-auto">
                                @foreach (string r in (string[])ViewBag.Roles)
                                {
                                    <option value="@r" selected="@(r == u.Role)">@r</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-primary">Apply</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>