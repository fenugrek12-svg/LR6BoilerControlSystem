@{
    ViewData["Title"] = "Паровий котел (Варіант 12)";
}

<div class="container text-center mt-3">
    <h2 class="mb-2">Мнемосхема технологічного процесу: Паровий котел</h2>
    <span class="badge bg-primary fs-6 mb-4">Система SCADA (Моніторинг через MQTT)</span>

    <div class="row justify-content-center align-items-center">
        <div class="col-md-7">
            <div class="card bg-light shadow-sm p-4 position-relative">
                <div class="row align-items-center">
                    <div class="col-4">
                        <div class="border border-danger rounded p-2 bg-white shadow-sm">
                            <small class="text-danger fw-bold">Температура (Temp)</small>
                            <div id="val-temp" class="fw-bold fs-4 text-danger">-- °C</div>
                            <small class="text-muted" style="font-size: 0.7rem;">boiler/1/sensors/water/temperature</small>
                        </div>
                    </div>

                    <div class="col-4">
                        <div class="bg-secondary text-white rounded-4 p-4 shadow" style="min-height: 220px; display: flex; flex-direction: column; justify-content: center;">
                            <h5 class="fw-bold">ПАРОВИЙ КОТЕЛ</h5>
                            <small>Boiler Unit #1</small>
                            <div class="border border-light rounded mt-3 p-2 bg-dark bg-opacity-50">
                                <small>ВОДЯНИЙ ОБ'ЄМ / ПАРА</small>
                            </div>
                        </div>
                    </div>

                    <div class="col-4 d-flex flex-column gap-3">
                        <div class="border border-primary rounded p-2 bg-white shadow-sm">
                            <small class="text-primary fw-bold">Тиск у котлі (Pressure)</small>
                            <div id="val-pressure" class="fw-bold fs-4 text-primary">-- бар</div>
                            <small class="text-muted" style="font-size: 0.7rem;">boiler/1/sensors/drum/pressure</small>
                        </div>

                        <div class="border border-success rounded p-2 bg-white shadow-sm">
                            <small class="text-success fw-bold">Рівень води (Water Level)</small>
                            <div id="val-level" class="fw-bold fs-4 text-success">-- %</div>
                            <small class="text-muted" style="font-size: 0.7rem;">boiler/1/sensors/drum/level</small>
                        </div>
                    </div>
                </div>

                <div class="mt-3 text-start">
                    <span id="mqtt-count" class="badge bg-secondary">Очікування MQTT...</span>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <form method="post" asp-action="Save">
                <button type="submit" class="btn btn-success btn-lg w-100 shadow">Зберегти показання в БД</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function fetchSensorData() {
            try {
                const [dataResp, threshResp] = await Promise.all([
                    fetch('/Home/GetSensorData'),
                    fetch('/Home/GetThresholds')
                ]);

                if (dataResp.redirected || threshResp.redirected) {
                    window.location.reload();
                    return;
                }

                const data = await dataResp.json();
                const thresholds = await threshResp.json();

                const tempTopic = 'boiler/1/sensors/water/temperature';
                const pressTopic = 'boiler/1/sensors/drum/pressure';
                const levelTopic = 'boiler/1/sensors/drum/level';

                if (data[tempTopic] !== undefined) {
                    const val = data[tempTopic];
                    const el = document.getElementById('val-temp');
                    if (el) {
                        el.innerText = val.toFixed(1) + ' °C';
                        const isAlarm = thresholds[tempTopic] !== undefined && val > thresholds[tempTopic];
                        el.className = isAlarm ? 'fw-bold fs-4 text-white bg-danger px-2 rounded' : 'fw-bold fs-4 text-danger';
                    }
                }
                if (data[pressTopic] !== undefined) {
                    const val = data[pressTopic];
                    const el = document.getElementById('val-pressure');
                    if (el) {
                        el.innerText = val.toFixed(2) + ' бар';
                        const isAlarm = thresholds[pressTopic] !== undefined && val > thresholds[pressTopic];
                        el.className = isAlarm ? 'fw-bold fs-4 text-white bg-danger px-2 rounded' : 'fw-bold fs-4 text-primary';
                    }
                }
                if (data[levelTopic] !== undefined) {
                    const val = data[levelTopic];
                    const el = document.getElementById('val-level');
                    if (el) {
                        el.innerText = val.toFixed(1) + ' %';
                        const isAlarm = thresholds[levelTopic] !== undefined && val > thresholds[levelTopic];
                        el.className = isAlarm ? 'fw-bold fs-4 text-white bg-danger px-2 rounded' : 'fw-bold fs-4 text-success';
                    }
                }

                const countEl = document.getElementById('mqtt-count');
                if (countEl) {
                    countEl.innerText = 'Отримано параметрів: ' + Object.keys(data).length;
                }
            } catch (e) {
                console.error('Помилка опитування датчиків:', e);
            }
        }

        setInterval(fetchSensorData, 2000);
        fetchSensorData();
    </script>
}